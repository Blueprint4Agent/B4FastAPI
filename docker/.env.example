# -------------------------------
# Runtime mode
# -------------------------------
# Values: development | production (production requires LOGIN_ENABLED=true).
APP_MODE=production

# -------------------------------
# Docker image
# -------------------------------
# Values: Docker image reference, e.g. blueprint4fastapi:local or registry/name:tag.
APP_IMAGE=blueprint4fastapi:local

# -------------------------------
# Compose project / Host ports
# -------------------------------
# Compose project and published host ports
# Keep "docker" to reuse volumes from the original setup (docker_postgres_data, etc.).
# For a separate installation, choose a unique name and unused host ports.
# Changing the project name selects a separate set of networks and data volumes.
# Values: Lowercase letters, digits, hyphens or underscores; start with a letter or digit.
COMPOSE_PROJECT_NAME=docker
# Values: Integer TCP port from 1 to 65535.
APP_HOST_PORT=8000
# Values: Integer TCP port from 1 to 65535.
POSTGRES_HOST_PORT=5432
# Values: Integer TCP port from 1 to 65535.
REDIS_HOST_PORT=6379
# Values: Integer TCP port from 1 to 65535.
GRAFANA_HOST_PORT=3000
# Values: Integer TCP port from 1 to 65535.
PROMETHEUS_HOST_PORT=9090
# Values: Integer TCP port from 1 to 65535.
OTEL_GRPC_HOST_PORT=4317
# Values: Integer TCP port from 1 to 65535.
OTEL_HTTP_HOST_PORT=4318
# These affect host access only; container DB_PORT=5432 and REDIS_PORT=6379 stay unchanged.

# -------------------------------
# Observability services
# -------------------------------
# Metrics target: host-run backend (make backend-dev) uses host.docker.internal:8000.
# Docker app (make docker-up) uses app:8000 on this project's default network.
# Use the backend's actual host port for host development; no http:// or /metrics.
# Values: hostname:port, e.g. host.docker.internal:8000 | app:8000; no URL scheme/path.
PROMETHEUS_BACKEND_TARGET=host.docker.internal:8000

# Grafana login (required only when starting Grafana).
# Set a non-default password. These initialize a NEW Grafana data volume only.
# Values: Non-empty Grafana administrator username (new volumes only).
GRAFANA_ADMIN_USER=admin
# Values: Non-empty unique administrator password when Grafana is used (new volumes only).
GRAFANA_ADMIN_PASSWORD=

# -------------------------------
# Deployment mode quick guide
# Mode A (local postgres + local redis):
#   DB_DRIVER=postgresql+asyncpg
#   DB_NAME=template
#   DB_HOST=postgres
#   REDIS_IN_MEMORY=false
#   REDIS_HOST=redis
# Mode B (external postgres + external redis):
#   DB_DRIVER=postgresql+asyncpg
#   DB_NAME=<existing-database-name>
#   DB_HOST=<external-db-host>
#   REDIS_IN_MEMORY=false
#   REDIS_HOST=<external-redis-host>
# Mode C (sqlite + in-memory redis):
#   DB_DRIVER=sqlite+aiosqlite
#   DB_NAME=template.db
#   REDIS_IN_MEMORY=true
# -------------------------------

# -------------------------------
# FastAPI server
# -------------------------------
# Values: Non-empty application display name.
APP_NAME=Blueprint4FastAPI API
# Values: Free-text telemetry label, e.g. local | docker | staging | production; does not select APP_MODE.
APP_ENV=docker
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
# Values: Integer TCP port from 1 to 65535.
APP_PORT=8000
# Values: Absolute HTTP(S) public frontend URL.
APP_BASE_URL=http://localhost:8000
# Values: true | false.
SWAGGER_ENABLED=true
# Values: Comma-separated allowed origins (HTTP(S) or tauri://localhost); no paths.
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# -------------------------------
# Observability / tracing
# TRACING_ENABLED=true sends traces to the local otel-collector service.
# Grafana UI: http://localhost:3000 (credentials configured above; no anonymous access)
# Database and observability published ports are bound to 127.0.0.1.
# Tempo and Loki APIs are Docker-network-only; query them through Grafana.
# -------------------------------
# Values: true | false.
METRICS_ENABLED=true
# Values: true | false.
TRACING_ENABLED=false
# Export application/Uvicorn logs through the same OTLP endpoint, independently of tracing.
# Values: true | false.
LOGS_ENABLED=false
# Values: Non-empty telemetry service name.
OTEL_SERVICE_NAME=blueprint4fastapi-backend
# Values: OTLP gRPC endpoint URL, e.g. http://localhost:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Values: true | false.
OTEL_EXPORTER_OTLP_INSECURE=true
# Values: Positive integer (seconds).
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
# Values: Number from 0.0 to 1.0.
OTEL_TRACE_SAMPLE_RATIO=1.0

# -------------------------------
# Auth
# -------------------------------
# Values: true | false; false only in development, also disables email and OAuth.
LOGIN_ENABLED=true
# If set to false, OAUTH_ENABLED and EMAIL_ENABLED are forced off at runtime.
# Used when LOGIN_ENABLED=false (frontend bootstraps this account from /config).
# Only email and name are configurable; id/profile_image/is_verified are fixed internally.
# Values: Dedicated development account email; only used with LOGIN_ENABLED=false.
BOOTSTRAP_USER_EMAIL=demo@example.com
# Values: Non-empty development account display name.
BOOTSTRAP_USER_NAME=Demo User
# Values: Secret signing string; use a strong unique random value for deployment.
SECRET_KEY=CHANGE_ME_FOR_PRODUCTION
# Values: HS256 | HS384 | HS512 for a shared SECRET_KEY.
ALGORITHM=HS256
# Values: Positive integer (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Values: Positive integer (days).
REFRESH_TOKEN_EXPIRE_DAYS=7
# Values: Positive integer (minutes).
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
# Values: Positive integer (minutes).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Values: Positive integer count.
LOGIN_FAILED_LIMIT=5
# Values: Positive integer (minutes).
LOGIN_LOCKED_MINUTES=5

# -------------------------------
# Database
# - Mode A: DB_HOST=postgres -> local postgres container auto-start
# - Mode B: DB_HOST!=postgres -> external DB
# - Mode C: sqlite+aiosqlite
# Change DB_DRIVER and DB_NAME together when switching database engines.
# PostgreSQL (Docker default): DB_NAME=template is a database name, not a file.
# SQLite: DB_DRIVER=sqlite+aiosqlite, DB_NAME=template.db is a file name.
# Host-run backend uses DB_HOST=localhost; container app uses DB_HOST=postgres.
# env-sync preserves existing values; it does not convert DB_NAME on driver changes.
# -------------------------------
# Values: sqlite+aiosqlite | postgresql+asyncpg.
DB_DRIVER=postgresql+asyncpg
# Values: SQLite file path (e.g. template.db) or existing PostgreSQL database name.
DB_NAME=template
# Values: Hostname or IP address.
DB_HOST=postgres
# Values: Integer TCP port from 1 to 65535.
DB_PORT=5432
# Values: PostgreSQL username; ignored for SQLite.
DB_USER=postgres
# Values: PostgreSQL password; ignored for SQLite.
DB_PASSWORD=postgres
# Local postgres uses DB_USER/DB_PASSWORD/DB_NAME to initialize a NEW volume.
# Existing databases require separate SQL account/password changes.

# -------------------------------
# Redis
# REDIS_IN_MEMORY=true lets the API run without docker/external Redis.
# Turn this off when using real Redis.
# - Mode A: REDIS_IN_MEMORY=false and REDIS_HOST=redis -> local redis auto-start
# - Mode B: REDIS_IN_MEMORY=false and REDIS_HOST!=redis -> external redis
# - Mode C: REDIS_IN_MEMORY=true -> in-memory redis mode
# -------------------------------
# Values: true | false.
REDIS_IN_MEMORY=false
# Values: Hostname or IP address.
REDIS_HOST=redis
# Values: Integer TCP port from 1 to 65535.
REDIS_PORT=6379
# Values: Non-negative integer database index available on the Redis server (usually 0-15).
REDIS_DB=0
# Values: Redis password, or empty for no authentication.
REDIS_PASSWORD=

# -------------------------------
# Background tasks / Celery
# -------------------------------
# Standalone Celery requires real Redis even when REDIS_IN_MEMORY=true.
# Empty URL uses REDIS_HOST/PORT/DB/PASSWORD. Set a rediss:// URL for TLS.
# Give each application sharing Redis its own queue and key prefix.
# Values: redis:// or rediss:// broker URL; empty derives it from Redis settings.
CELERY_BROKER_URL=
# Values: Non-empty application-specific queue name.
CELERY_QUEUE=b4fastapi.default
# Values: Non-empty application-specific Redis key prefix.
CELERY_KEY_PREFIX=b4fastapi:celery:
# A non-empty password enables authentication on local Redis and its healthcheck.
# Empty keeps passwordless local development; set a strong password for deployment.

# -------------------------------
# Email / SMTP
# EMAIL_ENABLED=false keeps mail sender disabled.
# -------------------------------
# Values: true | false.
EMAIL_ENABLED=false
# Values: Sender email address authorized by the SMTP provider.
EMAIL_FROM=no-reply@example.com
# Values: Non-empty display name used in email templates.
EMAIL_BRAND_NAME=B4A
# Values: Hostname or IP address; empty while email is disabled.
SMTP_HOST=
# Values: Integer TCP port from 1 to 65535.
SMTP_PORT=587
# Values: SMTP account username; empty when server authentication is not required.
SMTP_USERNAME=
# Values: SMTP account password; empty when server authentication is not required.
SMTP_PASSWORD=
# Values: true | false; set false when SMTP_USE_SSL=true.
SMTP_USE_STARTTLS=true
# Values: true | false; set false when SMTP_USE_STARTTLS=true.
SMTP_USE_SSL=false
# Values: Positive integer (seconds).
SMTP_TIMEOUT_SECONDS=10
# Values: true | false.
SMTP_VALIDATE_ON_STARTUP=true
# Requires a standalone Celery worker when EMAIL_ENABLED=true.
# Values: Non-negative integer retry count (0 disables retries).
EMAIL_QUEUE_MAX_RETRIES=3
# Values: Positive integer (seconds).
EMAIL_QUEUE_RETRY_DELAY_SECONDS=2

# -------------------------------
# OAuth
# OAUTH_ALLOWED_PROVIDERS supports: google,github
# -------------------------------
# Values: true | false.
OAUTH_ENABLED=false
# Values: google | github | google,github; comma-separated provider names.
OAUTH_ALLOWED_PROVIDERS=google,github
# Values: Positive integer (minutes).
OAUTH_STATE_EXPIRE_MINUTES=10
# Values: Frontend path starting with /, e.g. /dashboard.
OAUTH_FRONTEND_SUCCESS_PATH=/dashboard
# Values: Frontend path starting with /, e.g. /login.
OAUTH_FRONTEND_FAILURE_PATH=/login

# Values: Provider-issued OAuth client ID; empty when this provider is disabled.
OAUTH_GOOGLE_CLIENT_ID=
# Values: Provider-issued OAuth client secret; empty when this provider is disabled.
OAUTH_GOOGLE_CLIENT_SECRET=
# Values: Absolute HTTPS provider endpoint URL; use the provider default unless customized.
OAUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# Values: Absolute HTTPS provider endpoint URL; use the provider default unless customized.
OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# Values: Absolute HTTPS provider endpoint URL; use the provider default unless customized.
OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Values: Provider-issued OAuth client ID; empty when this provider is disabled.
OAUTH_GITHUB_CLIENT_ID=
# Values: Provider-issued OAuth client secret; empty when this provider is disabled.
OAUTH_GITHUB_CLIENT_SECRET=
# Values: Absolute HTTPS provider endpoint URL; use the provider default unless customized.
OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# Values: Absolute HTTPS provider endpoint URL; use the provider default unless customized.
OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# Values: Absolute HTTPS provider endpoint URL; use the provider default unless customized.
OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user

# -------------------------------
# Realtime / SSE
# -------------------------------
# Values: Positive integer (seconds).
SSE_HEARTBEAT_SECONDS=20
# Values: Positive integer (milliseconds).
SSE_RETRY_MILLIS=5000

# -------------------------------
# Billing / Stripe
# -------------------------------
# Stripe-hosted card / Link registration (no charges; disabled by default)
# Values: true | false.
STRIPE_ENABLED=false
# Values: whsec_... snapshot webhook signing secret; empty disables lifecycle webhook processing.
STRIPE_WEBHOOK_SECRET=
# Values: sk_test_... | sk_live_...; empty when Stripe is disabled.
STRIPE_SECRET_KEY=
# Use trusted absolute HTTP(S) URLs; success must contain {CHECKOUT_SESSION_ID}.
# Values: Trusted absolute HTTP(S) redirect URL containing {CHECKOUT_SESSION_ID}.
STRIPE_SETUP_SUCCESS_URL=http://localhost:5173/settings?billing_setup={CHECKOUT_SESSION_ID}
# Values: Trusted absolute HTTP(S) cancellation redirect URL.
STRIPE_SETUP_CANCEL_URL=http://localhost:5173/settings?billing_setup=cancelled

# -------------------------------
# Stripe subscriptions
# -------------------------------
# Recurring subscription Checkout uses STRIPE_ENABLED (server-owned Price IDs).
# Optional restricted customer portal configuration for profile/cards/invoices only.
# Values: bpc_... configuration ID, or empty to use the account default.
STRIPE_PORTAL_CONFIGURATION_ID=
# Values: price_... recurring Stripe Price ID matching the interval/currency; empty when unused.
STRIPE_MONTHLY_KRW_PRICE_ID=
# Values: price_... recurring Stripe Price ID matching the interval/currency; empty when unused.
STRIPE_MONTHLY_USD_PRICE_ID=
# Values: price_... recurring Stripe Price ID matching the interval/currency; empty when unused.
STRIPE_ANNUAL_KRW_PRICE_ID=
# Values: price_... recurring Stripe Price ID matching the interval/currency; empty when unused.
STRIPE_ANNUAL_USD_PRICE_ID=
# Tier prices. Legacy monthly/annual IDs remain recognized as Plus subscriptions.
# Values: price_... for Plus monthly KRW; empty keeps legacy Plus or disables Pro.
STRIPE_PLUS_MONTHLY_KRW_PRICE_ID=
# Values: price_... for Plus monthly USD; empty keeps legacy Plus or disables Pro.
STRIPE_PLUS_MONTHLY_USD_PRICE_ID=
# Values: price_... for Plus annual KRW; empty keeps legacy Plus or disables Pro.
STRIPE_PLUS_ANNUAL_KRW_PRICE_ID=
# Values: price_... for Plus annual USD; empty keeps legacy Plus or disables Pro.
STRIPE_PLUS_ANNUAL_USD_PRICE_ID=
# Values: price_... for Pro monthly KRW; empty keeps legacy Plus or disables Pro.
STRIPE_PRO_MONTHLY_KRW_PRICE_ID=
# Values: price_... for Pro monthly USD; empty keeps legacy Plus or disables Pro.
STRIPE_PRO_MONTHLY_USD_PRICE_ID=
# Values: price_... for Pro annual KRW; empty keeps legacy Plus or disables Pro.
STRIPE_PRO_ANNUAL_KRW_PRICE_ID=
# Values: price_... for Pro annual USD; empty keeps legacy Plus or disables Pro.
STRIPE_PRO_ANNUAL_USD_PRICE_ID=
# Values: Trusted absolute HTTP(S) redirect URL containing {CHECKOUT_SESSION_ID}.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/settings?billing_checkout={CHECKOUT_SESSION_ID}
# Values: Trusted absolute HTTP(S) cancellation redirect URL.
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/settings?billing_checkout=cancelled

# Public key for in-app card registration; must match secret key mode/account.
# Values: pk_test_... | pk_live_...; match secret key account and mode.
STRIPE_PUBLISHABLE_KEY=
