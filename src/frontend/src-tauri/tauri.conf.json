{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "B4FastAPI",
    "version": "0.1.0",
    "identifier": "com.blueprint4agent.b4fastapi",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev:tauri",
        "beforeBuildCommand": "npm run build:desktop"
    },
    "app": {
        "windows": [
            {
                "title": "B4FastAPI",
                "width": 1280,
                "height": 820,
                "minWidth": 960,
                "minHeight": 640,
                "center": true,
                "decorations": false,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8000 http://127.0.0.1:8000 https:; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
